  "tr": {
   "ne": "शुभ प्रभात, {name}! आज ठीक छ?",
   "es": "¡Buenos días, {name}! ¿Estás bien hoy?"
  }
 },
 {
  "id": "greet_morning_2",
  "ctx": "greet-morning",
  "ja": "{name}、おはよう！ よく ねられた？",
  "tr": {
   "ne": "{name}, शुभ प्रभात! राम्रोसँग सुत्यौ?",
   "es": "{name}, ¡buenos días! ¿Dormiste bien?"
  }
 },
 {
  "id": "greet_noon_1",
  "ctx": "greet-noon",
  "ja": "こんにちは、{name}！",
  "tr": {
   "ne": "नमस्ते, {name}!",
   "es": "¡Hola, {name}!"
  }
 },
 {
  "id": "greet_noon_2",
  "ctx": "greet-noon",
  "ja": "{name}、こんにちは！ おひるごはんは たべた？",
  "tr": {
   "ne": "{name}, नमस्ते! खाजा खायौ?",
   "es": "{name}, ¡hola! ¿Ya almorzaste?"
  }
 },
 {
  "id": "greet_evening_1",
  "ctx": "greet-evening",
  "ja": "こんばんは、{name}！ きょうも いちにち おつかれさま。",
  "tr": {
   "ne": "शुभ सन्ध्या, {name}! आज दिनभर मेहनत गर्यौ, धन्यवाद।",
   "es": "¡Buenas noches, {name}! Gracias por el esfuerzo de hoy."
  }
 },
 {
  "id": "season_spring_1",
  "ctx": "season-spring",
  "ja": "{name}、はるに なって、あたたかく なってきたね。",
  "tr": {
   "ne": "{name}, वसन्त आयो, न्यानो हुँदै छ।",
   "es": "{name}, ya es primavera y hace más calor."
  }
 },
 {
  "id": "season_summer_1",
  "ctx": "season-summer",
  "ja": "{name}、きょうは あつく なってきたね。みずを のもうね。",
  "tr": {
   "ne": "{name}, आज गर्मी हुँदै छ। पानी पिऔं है।",
   "es": "{name}, hoy empieza a hacer calor. Vamos a tomar agua."
  }
 },
 {
  "id": "season_autumn_1",
  "ctx": "season-autumn",
  "ja": "{name}、すずしく なってきたね。もう あきだね。",
  "tr": {
   "ne": "{name}, चिसो हुँदै छ। अब शरद ऋतु भयो।",
   "es": "{name}, ya refresca. Ya es otoño."
  }
 },
 {
  "id": "season_winter_1",
  "ctx": "season-winter",
  "ja": "{name}、きょうは さむいね。あったかく して いてね。",
  "tr": {
   "ne": "{name}, आज जाडो छ। न्यानो लगाउनू है।",
   "es": "{name}, hoy hace frío. Abrígate bien."
  }
 },
 {
  "id": "praise_1",
  "ctx": "praise",
  "ja": "{name}、よく できたね！",
  "tr": {
   "ne": "{name}, राम्रो गर्‍यौ!",
   "es": "{name}, ¡lo hiciste muy bien!"
  }
 },
 {
  "id": "praise_2",
  "ctx": "praise",
  "ja": "{name}、すごいね！",
  "tr": {
   "ne": "{name}, कति राम्रो!",
   "es": "{name}, ¡increíble!"
  }
 },
 {
  "id": "praise_3",
  "ctx": "praise",
  "ja": "{name}、じょうずだね！ えらいね！",
  "tr": {
   "ne": "{name}, वाह! धेरै राम्रो!",
   "es": "{name}, ¡qué bien! ¡Muy bien hecho!"
  }
 },
 {
  "id": "praise_4",
  "ctx": "praise",
  "ja": "やったね、{name}！ がんばったね！",
  "tr": {
   "ne": "गज्जब, {name}! मेहनत गर्‍यौ!",
   "es": "¡Lo lograste, {name}! ¡Te esforzaste!"
  }
 },
 {
  "id": "empathy_1",
  "ctx": "empathy",
  "ja": "{name}、だいじょうぶ？",
  "tr": {
   "ne": "{name}, ठीक छ?",
   "es": "{name}, ¿estás bien?"
  }
 },
 {
  "id": "empathy_2",
  "ctx": "empathy",
  "ja": "{name}、むずかしかったね。だいじょうぶ、もういちど やってみよう。",
  "tr": {
   "ne": "{name}, गाह्रो भयो। ठीक छ, फेरि प्रयास गरौं।",
   "es": "{name}, fue difícil. No pasa nada, intentemos otra vez."
  }
 },
 {
  "id": "empathy_3",
  "ctx": "empathy",
  "ja": "{name}、つかれたかな？ ちょっと やすもうか。",
  "tr": {
   "ne": "{name}, थाक्यौ? अलिकति आराम गरौं।",
   "es": "{name}, ¿estás cansado/a? Descansemos un poco."
  }
 },
 {
  "id": "cheer_1",
  "ctx": "cheer",
  "ja": "{name}、がんばれー！",
  "tr": {
   "ne": "{name}, हौसला राख!",
   "es": "{name}, ¡ánimo!"
  }
 },
 {
  "id": "cheer_2",
  "ctx": "cheer",
  "ja": "{name}、いっしょに やろう！",
  "tr": {
   "ne": "{name}, सँगै गरौं!",
   "es": "{name}, ¡hagámoslo juntos!"
  }
 },
 {
  "id": "end_1",
  "ctx": "end",
  "ja": "{name}、きょうは よく がんばったね。また あしたね！",
  "tr": {
   "ne": "{name}, आज धेरै मेहनत गर्‍यौ। भोलि भेटौँला!",
   "es": "{name}, hoy te esforzaste mucho. ¡Hasta mañana!"
  }
 }
]